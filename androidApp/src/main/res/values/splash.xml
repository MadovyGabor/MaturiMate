<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The splash background is the app's own screen background (design token "background", light), so opening the app
         does not flash from a dark splash to the cream screen. The dark value is in values-night. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FCF8F1</item>
        <item name="postSplashScreenTheme">@style/Theme.App.Main</item>
    </style>

    <!-- The theme of the activity after the splash screen. Its window background is the app background too, so the moment
         the activity is rebuilt (a new app language) shows the cream paper and not a black or white frame. -->
    <style name="Theme.App.Main" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FCF8F1</item>
    </style>

</resources>
