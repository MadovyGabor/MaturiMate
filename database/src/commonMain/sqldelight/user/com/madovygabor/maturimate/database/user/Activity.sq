-- Study streak and daily activity of the user. Same tables as in supabase/migrations,
-- without the foreign keys to auth.users.
-- `updated_at` (epoch milliseconds) is set on every write, see Progress.sq.
CREATE TABLE user_streak (
    user_id             TEXT    NOT NULL,
    current_streak      INTEGER NOT NULL DEFAULT 0,
    longest_streak      INTEGER NOT NULL DEFAULT 0,
    last_activity_date  TEXT,
    updated_at          INTEGER NOT NULL DEFAULT (CAST(ROUND((julianday('now') - 2440587.5) * 86400000) AS INTEGER)),
    CONSTRAINT pk_user_streak PRIMARY KEY (user_id),
    CONSTRAINT ck_user_streak_values
        CHECK (current_streak >= 0 AND longest_streak >= current_streak)
);

-- The study time of a day, one row per device: two devices of one account add their time up exactly.
-- The screens read the sum of a day.
CREATE TABLE activity_log (
    activity_id      INTEGER CONSTRAINT pk_activity_log PRIMARY KEY,
    user_id          TEXT    NOT NULL,
    activity_date    TEXT    NOT NULL,
    device_id        TEXT    NOT NULL,
    seconds_studied  INTEGER NOT NULL DEFAULT 0,
    tasks_answered   INTEGER NOT NULL DEFAULT 0,
    updated_at       INTEGER NOT NULL DEFAULT (CAST(ROUND((julianday('now') - 2440587.5) * 86400000) AS INTEGER)),
    CONSTRAINT uq_activity_log_day UNIQUE (user_id, activity_date, device_id),
    CONSTRAINT ck_activity_log_values
        CHECK (seconds_studied >= 0 AND tasks_answered >= 0)
);

selectStreak:
SELECT * FROM user_streak WHERE user_id = :userId;

upsertStreak:
INSERT OR REPLACE INTO user_streak (user_id, current_streak, longest_streak, last_activity_date)
VALUES (?, ?, ?, ?);

-- the sum of each day over the devices
selectActivity:
SELECT activity_date,
       coalesce(sum(seconds_studied), 0) AS seconds_studied,
       coalesce(sum(tasks_answered), 0) AS tasks_answered
FROM activity_log
WHERE user_id = :userId AND activity_date BETWEEN :fromDate AND :toDate
GROUP BY activity_date
ORDER BY activity_date;

-- adds to this device's row of the day, creating it on the first activity of the day
-- (no ON CONFLICT upsert: the SQLite of Android API 24 is older than 3.24)
addActivity {
    INSERT OR IGNORE INTO activity_log (user_id, activity_date, device_id)
    VALUES (:userId, :activityDate, :deviceId);

    UPDATE activity_log SET
        seconds_studied = seconds_studied + :seconds,
        tasks_answered = tasks_answered + :tasks,
        updated_at = CAST(ROUND((julianday('now') - 2440587.5) * 86400000) AS INTEGER)
    WHERE user_id = :userId AND activity_date = :activityDate AND device_id = :deviceId;
}
