-- Profile, role, settings and subjects of the user. Same tables as in supabase/migrations,
-- without the foreign keys to auth.users, role and subject (server-only and content-database tables).
-- Phone only: first_name and last_name may be empty, because a guest has no name until sign-up.
CREATE TABLE user_profile (
    user_id            TEXT    NOT NULL,
    first_name         TEXT,
    last_name          TEXT,
    display_name       TEXT,
    date_of_birth      TEXT,
    school_type        TEXT,
    teaching_language  TEXT,
    graduation_date    TEXT,
    -- epoch milliseconds; empty while the onboarding is not finished
    onboarding_completed_at  INTEGER,
    CONSTRAINT pk_user_profile PRIMARY KEY (user_id),
    CONSTRAINT ck_user_profile_birth CHECK (date_of_birth >= '1900-01-01'),
    CONSTRAINT ck_user_profile_school_type
        CHECK (school_type IN ('GYMNASIUM', 'VOCATIONAL', 'OTHER')),
    CONSTRAINT ck_user_profile_language CHECK (teaching_language IN ('SK', 'HU'))
);

-- role_id follows the role catalogue seeded in supabase/migrations (1 STUDENT, 2 LEARNER, 3 TEACHER, 4 CURATOR, 5 ADMIN)
CREATE TABLE user_role (
    user_id      TEXT    NOT NULL,
    role_id      INTEGER NOT NULL,
    assigned_at  INTEGER NOT NULL,
    CONSTRAINT pk_user_role PRIMARY KEY (user_id, role_id),
    CONSTRAINT ck_user_role_role CHECK (role_id BETWEEN 1 AND 5)
);

CREATE TABLE user_settings (
    user_id             TEXT    NOT NULL,
    ui_language         TEXT    NOT NULL DEFAULT 'SK',
    timezone            TEXT    NOT NULL DEFAULT 'Europe/Bratislava',
    theme               TEXT    NOT NULL DEFAULT 'SYSTEM',
    daily_goal_minutes  INTEGER DEFAULT 10,
    reminder_enabled    INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0 CHECK (reminder_enabled IN (0, 1)),
    reminder_time       TEXT,
    CONSTRAINT pk_user_settings PRIMARY KEY (user_id),
    CONSTRAINT ck_user_settings_language CHECK (ui_language IN ('SK', 'HU')),
    CONSTRAINT ck_user_settings_theme CHECK (theme IN ('LIGHT', 'DARK', 'SYSTEM')),
    CONSTRAINT ck_user_settings_goal
        CHECK (daily_goal_minutes BETWEEN 1 AND 240),
    CONSTRAINT ck_user_settings_reminder
        CHECK (reminder_enabled = 0 OR reminder_time IS NOT NULL)
);

CREATE TABLE user_subject (
    user_id       TEXT    NOT NULL,
    subject_id    INTEGER NOT NULL,
    target_score  REAL,
    source        TEXT    NOT NULL DEFAULT 'CHOSEN',
    added_at      INTEGER NOT NULL,
    -- the level of a subject that has levels (English: B1 or B2); empty for the others
    level         TEXT,
    CONSTRAINT pk_user_subject PRIMARY KEY (user_id, subject_id),
    CONSTRAINT ck_user_subject_score CHECK (target_score BETWEEN 0 AND 100),
    CONSTRAINT ck_user_subject_source CHECK (source IN ('AUTO', 'CHOSEN')),
    CONSTRAINT ck_user_subject_level CHECK (level IN ('B1', 'B2'))
);

-- Phone only: whose rows the local tables hold. A guest gets a temporary id ("guest-" and a
-- random UUID); sign-up replaces it with the account's id (roadmap step 7.5). One row at most.
CREATE TABLE local_user (
    slot      INTEGER NOT NULL CONSTRAINT pk_local_user PRIMARY KEY,
    user_id   TEXT    NOT NULL,
    is_guest  INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1 CHECK (is_guest IN (0, 1)),
    CONSTRAINT ck_local_user_slot CHECK (slot = 1)
);

selectLocalUser:
SELECT * FROM local_user WHERE slot = 1;

-- keeps the existing row, so two first calls agree on one id
insertLocalUser:
INSERT OR IGNORE INTO local_user (slot, user_id, is_guest) VALUES (1, :userId, :isGuest);

-- After sign-up or sign-in: every row of the guest becomes the account's, in one transaction.
-- A row the account already has on this phone is replaced by the guest's (UPDATE OR REPLACE).
adoptAccount {
UPDATE OR REPLACE user_profile SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE user_settings SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE user_role SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE user_subject SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE attempt SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE attempt_answer SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE user_unit_progress SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE user_task_progress SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE user_streak SET user_id = :accountId WHERE user_id = :guestId;
UPDATE OR REPLACE activity_log SET user_id = :accountId WHERE user_id = :guestId;
INSERT OR REPLACE INTO local_user (slot, user_id, is_guest) VALUES (1, :accountId, 0);
}

-- Signing in to another account on this phone: the previous account's rows are removed (they
-- are on the server after its sign-up) instead of being given to the new account.
switchAccount {
DELETE FROM user_profile WHERE user_id = :previousId;
DELETE FROM user_settings WHERE user_id = :previousId;
DELETE FROM user_role WHERE user_id = :previousId;
DELETE FROM user_subject WHERE user_id = :previousId;
DELETE FROM attempt_answer WHERE user_id = :previousId;
DELETE FROM attempt WHERE user_id = :previousId;
DELETE FROM user_unit_progress WHERE user_id = :previousId;
DELETE FROM user_task_progress WHERE user_id = :previousId;
DELETE FROM user_streak WHERE user_id = :previousId;
DELETE FROM activity_log WHERE user_id = :previousId;
INSERT OR REPLACE INTO local_user (slot, user_id, is_guest) VALUES (1, :accountId, 0);
}

updateNames:
UPDATE user_profile SET first_name = :firstName, last_name = :lastName WHERE user_id = :userId;

selectProfile:
SELECT * FROM user_profile WHERE user_id = :userId;

upsertProfile:
INSERT OR REPLACE INTO user_profile VALUES ?;

-- profile and settings of one user; empty until the first save creates both rows
selectUserProfile:
SELECT p.teaching_language, p.graduation_date, p.onboarding_completed_at,
       s.ui_language, s.daily_goal_minutes, s.timezone, s.reminder_enabled, s.reminder_time
FROM user_profile p
JOIN user_settings s ON s.user_id = p.user_id
WHERE p.user_id = :userId;

ensureProfile:
INSERT OR IGNORE INTO user_profile (user_id) VALUES (:userId);

-- the daily goal stays empty until the user answers it, so the onboarding knows it was asked
ensureSettings:
INSERT OR IGNORE INTO user_settings (user_id, timezone, daily_goal_minutes) VALUES (:userId, :timezone, NULL);

updateTeachingLanguage:
UPDATE user_profile SET teaching_language = :language WHERE user_id = :userId;

updateGraduationDate:
UPDATE user_profile SET graduation_date = :date WHERE user_id = :userId;

updateOnboardingCompletedAt:
UPDATE user_profile SET onboarding_completed_at = :completedAt WHERE user_id = :userId;

updateUiLanguage:
UPDATE user_settings SET ui_language = :language WHERE user_id = :userId;

updateReminder:
UPDATE user_settings SET reminder_enabled = :enabled, reminder_time = :time WHERE user_id = :userId;

updateDailyGoal:
UPDATE user_settings SET daily_goal_minutes = :minutes WHERE user_id = :userId;

selectRoles:
SELECT * FROM user_role WHERE user_id = :userId ORDER BY role_id;

insertRole:
INSERT OR IGNORE INTO user_role VALUES ?;

-- the roles a user picks in the onboarding (student, learner, teacher); curator and admin stay
deleteOnboardingRoles:
DELETE FROM user_role WHERE user_id = :userId AND role_id IN (1, 2, 3);

deleteRoles:
DELETE FROM user_role WHERE user_id = :userId;

selectSettings:
SELECT * FROM user_settings WHERE user_id = :userId;

upsertSettings:
INSERT OR REPLACE INTO user_settings VALUES ?;

selectSubjects:
SELECT * FROM user_subject WHERE user_id = :userId ORDER BY added_at;

insertSubject:
INSERT OR IGNORE INTO user_subject VALUES ?;

deleteSubjects:
DELETE FROM user_subject WHERE user_id = :userId;

deleteSubject:
DELETE FROM user_subject WHERE user_id = :userId AND subject_id = :subjectId;
